# Same pattern as the API's Dockerfile: a builder stage that installs, and a
# clean runtime stage that receives only the finished environment.

# ---------- Stage 1: builder ----------
FROM python:3.12-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.11.3 /uv /usr/local/bin/uv

WORKDIR /app

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

# The `dashboard` group only: Streamlit and what the page imports.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --only-group dashboard --no-install-project


# ---------- Stage 2: runtime ----------
FROM python:3.12-slim

RUN useradd --create-home --uid 1000 appuser

WORKDIR /app

COPY --from=builder /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH"

# Only the page itself. No model, no customer data: predictions come from the
# API, and customer data is mounted at run time by Compose.
COPY src/dashboard.py src/

EXPOSE 8501

USER appuser

# Streamlit serves its own health endpoint.
HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health')" || exit 1

# headless: no attempt to open a browser inside the container.
CMD ["streamlit", "run", "src/dashboard.py", \
     "--server.address=0.0.0.0", "--server.port=8501", \
     "--server.headless=true", "--browser.gatherUsageStats=false"]
